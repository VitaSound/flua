#!/usr/bin/env bash
# flua-verify <file.lua> — быстрая проверка для ИИ/разработчика:
#   1. транспиляция Lua → Forth (режимы функций — по прагмам -- @stack / -- @proc);
#   2. компиляция сгенерированного Forth гforth'ом (ловит синтаксис
#      и undefined words — например, вызов несуществующего слова).
#
# Выход 0 — можно доверять генерату; 1 — есть проблемы (парсинг
# или невалидный Forth), причины печатаются в stderr.
#
# Проверка ВЫПОЛНЕНИЯ (что функция даёт нужный результат):
#   flua file.lua > /tmp/x.4th
#   gforth -e 'include /tmp/x.4th 2 3 add . cr bye'    # → 5

: "${FLUA_HOME:=$HOME/flua}"
GFORTH="${GFORTH:-gforth}"

if [ $# -lt 1 ]; then
    echo "usage: flua-verify file.lua" >&2
    exit 2
fi

src=$1
if [ ! -r "$src" ]; then
    echo "flua-verify: нет файла: $src" >&2
    exit 2
fi

tmp=$(mktemp -d) || exit 2
trap 'rm -rf "$tmp"' EXIT

fail=0

if ! "$FLUA_HOME/bin/flua" "$src" > "$tmp/out.4th" 2> "$tmp/trans"; then
    echo "FAIL транспиляция: $src" >&2
    sed 's/^/    /' "$tmp/out.4th" >&2
    sed 's/^/    /' "$tmp/trans" >&2
    exit 1
fi

if "$GFORTH" -e "include $tmp/out.4th bye" 2> "$tmp/err"; then
    echo "OK   $src"
else
    echo "FAIL сгенерированный Forth не компилируется: $src" >&2
    grep -m 3 'error:' "$tmp/err" >&2 || sed 's/^/    /' "$tmp/err" >&2
    fail=1
fi

exit $fail
